# Copier vers .env.local et renseigner. .env.local est ignoré par git.

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Clé service_role. SERVEUR UNIQUEMENT : elle contourne la RLS.
# Ne jamais la préfixer NEXT_PUBLIC_, ne jamais l'importer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe unique d'accès à l'application. 24 caractères ou plus.
APP_PASSWORD=

# Secret de signature du cookie de session.
# Générer avec :  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=
